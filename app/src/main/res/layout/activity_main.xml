<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F6F9"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header / App Bar -->
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#6750A4"
            android:gravity="center"
            android:text="Business Card Maker"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="#EDEDF4"
                android:hint="e.g. Dan Smith"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textSize="16sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRole"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="#EDEDF4"
                android:hint="e.g. Android Developer"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="16sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="#EDEDF4"
                android:hint="e.g. 051-1234567"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textSize="16sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Website"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWebsite"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="#EDEDF4"
                android:hint="e.g. google.com"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textSize="16sp" />


            <Button
                android:id="@+id/btnCreateCard"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#6750A4"
                android:text="Create Card"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />
            <Button
                android:id="@+id/btnInfo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#6750A4"
                android:text="About"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>